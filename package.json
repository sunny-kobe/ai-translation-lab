{
  "name": "ai-translation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "db:migrate": "tsx server/migrate.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/api.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run typecheck && npm test && vite build",
    "smoke": "node scripts/smoke.mjs",
    "db:local": "tsx scripts/local-db.ts",
    "smoke:restart": "node scripts/restart-smoke.mjs",
    "format": "prettier --write shared server web tests scripts docs *.json *.ts *.md *.yaml public",
    "format:check": "prettier --check shared server web tests scripts docs *.json *.ts *.md *.yaml public"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.41",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^5.27.4",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
